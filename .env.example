# ---- Speedo Live configuration (copy to backend/.env or set in your host) ----
APP_ENV=development                 # production enables HSTS and requires JWT_SECRET
SPEEDO_MODE=demo                    # demo = sample routes + simulated buses (labelled DEMO); live = real data only
GPS_SOURCE=driver_app               # driver_app | provider (authorised on-board GPS feed)
# GPS_PROVIDER_URL=https://provider.example/api/positions
# GPS_PROVIDER_TOKEN=

# Database: SQLite for local development, PostgreSQL (+PostGIS) in production
DATABASE_URL=sqlite:///./data/speedo.db
# DATABASE_URL=postgresql://speedo:CHANGE_ME@db:5432/speedo
ENABLE_POSTGIS=false
# REDIS_URL=redis://localhost:6379/0

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_MINUTES=720
CORS_ORIGINS=                       # comma-separated, only if the web app is on another domain
TRUST_PROXY=false                   # true behind a reverse proxy that sets X-Forwarded-For
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20

# First administrator (created once if no admin exists)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Password for the demo accounts seeded in demo mode
DEMO_PASSWORD=Demo@12345

# Tracking
GPS_INTERVAL_SECONDS=5
GPS_STALE_AFTER_SECONDS=45
GPS_OFFLINE_AFTER_SECONDS=180
GPS_LOW_ACCURACY_METERS=50
GPS_REJECT_ACCURACY_METERS=200
GPS_RETENTION_DAYS=30
DELAY_THRESHOLD_MINUTES=5
AREA_MIN_LAT=31.20
AREA_MAX_LAT=31.80
AREA_MIN_LON=74.00
AREA_MAX_LON=74.60

# Push notifications (Firebase Cloud Messaging HTTP v1)
# FCM_PROJECT_ID=your-firebase-project
# FCM_SERVICE_ACCOUNT_FILE=/run/secrets/fcm-service-account.json
