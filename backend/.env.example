# Copy to backend/.env and fill in. Never commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://speedo:speedo@localhost:5432/speedo
REDIS_URL=redis://localhost:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
# demo | driver | provider
DATA_SOURCE=demo
STALE_AFTER_SECONDS=60
OFFLINE_AFTER_SECONDS=300
GPS_MAX_ACCURACY_M=100
GPS_RETENTION_DAYS=30
# Firebase Cloud Messaging (optional; without it notifications stay in the in-app inbox)
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# Seed account passwords (optional)
SEED_ADMIN_PASSWORD=
SEED_DRIVER_PASSWORD=
SEED_PASSENGER_PASSWORD=
