# Copy to backend/.env and fill in. Never commit the real .env or the service-account file.
ENVIRONMENT=development

# --- Firebase (Firestore database, Authentication, Storage, Cloud Messaging) -----------------
# Firebase console > Project settings > General
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
# Project settings > Service accounts > Generate new private key. Save the file outside git, e.g.
# backend/firebase-service-account.json (ignored by .gitignore). On hosts without files, put the
# file's JSON content in FIREBASE_CREDENTIALS_JSON instead.
FIREBASE_CREDENTIALS_FILE=firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
# Storage > bucket name, e.g. your-project.firebasestorage.app (optional: archives imported route files)
FIREBASE_STORAGE_BUCKET=

# --- API ---------------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# driver = positions come only from driver apps (default) | provider = approved GPS feed | demo = simulator
DATA_SOURCE=driver
STALE_AFTER_SECONDS=60
OFFLINE_AFTER_SECONDS=300
GPS_MAX_ACCURACY_M=100
GPS_RETENTION_DAYS=30
# Optional: only needed when running more than one API process
REDIS_URL=
