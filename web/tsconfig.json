{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": false,
    "outDir": "public/js",
    "rootDir": "src",
    "sourceMap": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
