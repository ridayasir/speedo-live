{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{backend/app/**,backend/migrations/**,backend/seed/**,web/public/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/:path*", "destination": "/api/index?__p=/:path*" }]
}
